{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": true,
        ".write": "auth != null && $room.matches(/^[a-z0-9-]{1,40}$/)",
        "opacity": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "lang": {
          ".validate": "newData.isString() && (newData.val() === 'en' || newData.val() === 'ro')"
        },
        "command": {
          ".validate": "newData.hasChild('type')",
          "type": { ".validate": "newData.isString() && (newData.val() === 'show' || newData.val() === 'clear' || newData.val() === 'carousel')" },
          "overlay": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "duration": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600000" },
          "ts": { ".validate": "newData.isNumber()" },
          "interval": { ".validate": "newData.isNumber() && newData.val() >= 1000 && newData.val() <= 600000" },
          "cycles": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
          "skipEmpty": { ".validate": "newData.isBoolean()" },
          "overlays": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "newData.isString() && newData.val().length <= 40" }
          },
          "$other": { ".validate": false }
        },
        "colors": {
          "$c": { ".validate": "newData.isString() && newData.val().length <= 9" }
        },
        "match": {
          ".validate": "newData.hasChildren()"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
